        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Gancho pre-commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Barra o commit ruim&lt;/font&gt;" id="n_pre_commit" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Antes de cada commit: bloqueia credenciais, arquivos do robô que nunca sobem, CPF de hóspede de verdade (LGPD) e erro do ruff." regras="Sem estado/ (PC de casa), a parte do CPF não roda." codigo=".githooks/pre-commit e ferramentas/checar_commit.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="3660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Trava de git do Claude&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Bloqueia comando que apaga trabalho&lt;/font&gt;" id="n_guarda_git" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Impede o Claude de rodar push forçado, apagar branch, reset --hard, clean e checkout/restore de tudo. O push normal continua liberado." codigo="ferramentas/guarda_git.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="3660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Testes automáticos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;625 testes em 89 arquivos&lt;/font&gt;" id="n_testes" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Os testes usam dados inventados e não tocam em Google nem Outlook. Há também testes de tela com o Edge, que são pulados sem requirements-dev.txt." codigo="testes/">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="3660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;GitHub Actions: Testes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Roda os testes a cada push&lt;/font&gt;" id="n_ci_testes" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="A cada push nas 4 branches e em pull request na main, o GitHub roda os testes. Permissão só de leitura." codigo=".github/workflows/testes.yml">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1470" y="3660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;ruff.toml e requirements-dev.txt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Checagem de código&lt;/font&gt;" id="n_ruff_cfg" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Configuração do ruff (só erro real) e das ferramentas de desenvolvimento: ruff e playwright." codigo="ruff.toml, requirements-dev.txt">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1940" y="3660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;outlook_aviso_endereco&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Aviso do endereço do Outlook&lt;/font&gt;" id="n_aviso_endereco" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Arquivos .reg e um script para liberar o aviso de endereço do Outlook. Está preparado e NÃO foi aplicado: o valor precisa ser testado em um PC antes." regras="Não aplicar nos outros PCs antes de testar em um." codigo="ferramentas/outlook_aviso_endereco/">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2410" y="3660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Apps Script da Planilha Central&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Menu dentro da planilha&lt;/font&gt;" id="n_apps_script" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Menu da Planilha Central (buscar hotel, verificar pendências, ativar o Claudio, envio separado, log, cota, conferir cópia). Roda dentro do Google, só lê e grava pedidos na aba Status; quem envia e-mail é o robô." codigo="apps_script/menu_planilha_central.gs">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="3810" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;saida_simulacao/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;E-mail de exemplo gerado&lt;/font&gt;" id="n_saida_sim" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Pasta com o e-mail de exemplo que a simulação gera. Fora do git." codigo="saida_simulacao/">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="3810" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cofre Segundo Cérebro (Obsidian)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;A memória do projeto&lt;/font&gt;" id="n_cofre" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Regras, decisões, incidentes, diário, mapa do projeto e este diagrama. Fica dentro do repositório, então chega aos 4 PCs." regras="Nunca guardar senhas, chaves nem dado real de hóspede." codigo="Segundo Cérebro (Agente Smith)/">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="3810" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FERRAMENTA&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;CLAUDE.md, DESIGN.md, PRODUCT.md, CHANGELOG.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Instruções e histórico&lt;/font&gt;" id="n_docs" tipo="Ferramenta" roda_em="Cópia de trabalho / GitHub" o_que_faz="Os arquivos que dizem ao Claude como trabalhar, o design, o produto e o que mudou em cada versão." codigo="CLAUDE.md, DESIGN.md, PRODUCT.md, CHANGELOG.md, README.md">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1470" y="3810" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;João&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;PC principal&lt;/font&gt;" id="n_pc_joao" tipo="Computador" roda_em="Trabalho" o_que_faz="Além do que todos os PCs rodam, este faz a cópia dos hotéis (a cada 10 min), a vigia de formulários, o robô de envio, a conferência diária e a faxina. Fim de semana trabalham João e Cristian." regras="Todos os PCs rodam: Painel (tarefa no logon), conferente, guardião e vigia do Outlook.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="4110" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Clara&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Painel, conferente e Outlook&lt;/font&gt;" id="n_pc_clara" tipo="Computador" roda_em="Trabalho" o_que_faz="Roda o Painel e o conferente e tem no Outlook as caixas dos hotéis dela. Sem permissão de administrador: liberar a porta 8766 no firewall exige alguém com administrador.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1470" y="4110" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cristian&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Painel, conferente e Outlook&lt;/font&gt;" id="n_pc_cris" tipo="Computador" roda_em="Trabalho" o_que_faz="Roda o Painel e o conferente. Trabalha no fim de semana junto com o João, e esse fim de semana conta para ele na Gerência.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1940" y="4110" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Bernardo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Painel, conferente e Outlook&lt;/font&gt;" id="n_pc_bern" tipo="Computador" roda_em="Trabalho" o_que_faz="Roda o Painel e o conferente e tem no Outlook as caixas dos hotéis dele.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2410" y="4110" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <mxCell id="nota_1" value="&lt;b&gt;Cota do Google&lt;/b&gt;&lt;br&gt;60 leituras por minuto somando os 4 PCs. Toda leitura nova entra na conta; por isso cada programa tem a sua fatia (cota_google.py)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="4110" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="nota_2" value="&lt;b&gt;Nada acumula&lt;/b&gt;&lt;br&gt;O Painel não é histórico: quem guarda é o Outlook e a planilha de cada hotel. As abas de registro têm faxina de 3 a 7 dias." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="4110" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="nota_3" value="&lt;b&gt;Dado de hóspede&lt;/b&gt;&lt;br&gt;Só no Outlook e no índice local de cada PC. Nunca em arquivo de teste, documento ou GitHub." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2880" y="4110" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="nota_4" value="&lt;b&gt;Como ler este mapa&lt;/b&gt;&lt;br&gt;Cada bloco é um programa, arquivo ou serviço. As linhas coloridas mostram por onde o dado anda. Clique num bloco para ver também quem ele usa e quem o usa (linhas cinza)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3350" y="4110" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;CAMINHOS (cor da linha)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Produção de ponta a ponta&lt;br&gt;&lt;font color=&quot;#5aa9ff&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Pedido do hóspede até o e-mail ao hotel&lt;br&gt;&lt;font color=&quot;#ffb454&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; E-mails, Outlook e telas&lt;br&gt;&lt;font color=&quot;#b69cff&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Nota fiscal e envio ao hóspede&lt;br&gt;&lt;font color=&quot;#ff7ab6&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Os 4 PCs entre si&lt;br&gt;&lt;font color=&quot;#8fa1b8&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Código, testes e atualização&lt;br&gt;&lt;font color=&quot;#46d3e6&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Números da Gerência&lt;br&gt;&lt;font color=&quot;#ff6b6b&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Faxina e saúde&lt;br&gt;&lt;font color=&quot;#d9c26a&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Instalar e manter os PCs&lt;br&gt;&lt;font color=&quot;#6f7d90&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Quem usa quem (dependências)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#93a1b8&quot;&gt;Linha tracejada com setas: o sentido em que o dado anda.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#141b2a;strokeColor=#25324a;fontColor=#e8edf6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="-330" width="480" height="280" as="geometry"/></mxCell>
