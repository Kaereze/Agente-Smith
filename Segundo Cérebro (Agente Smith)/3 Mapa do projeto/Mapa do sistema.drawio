          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3820" y="2160" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;AÇÃO  ·  com token&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Ações do agente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;O que a equipe faz na tela&lt;/font&gt;" id="n_acoes" tipo="Ação" quando="com token" roda_em="Cada PC" o_que_faz="Marcar lido ou não lido, urgência, excluir (com Desfazer por 10 s), responder, encaminhar, tratativa, nota dividida, Ligação, concluir a conversa e mover para a pasta NF enviada." regras="O Painel nunca tira nem apaga e-mail da entrada sozinho. | Abrir um e-mail no Painel marca como lido no Outlook." codigo="src/app_servidor.py (rotas /api/...)">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="4290" y="585" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  confirma&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Itens Enviados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;A prova de que saiu&lt;/font&gt;" id="n_itens" tipo="Processo" quando="confirma" roda_em="Outlook do PC dono" o_que_faz="O envio só conta como feito depois que o e-mail aparece em Itens Enviados. Só então o robô marca TRUE e o conferente reconhece a nota." regras="Resposta do hóspede com a nota anexada não conta como envio.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="4290" y="960" width="250" height="92" as="geometry"/></mxCell>
