        </object>
        <object label="marca TRUE depois de confirmar" id="e_10_robo__planhot" caminho="Pedido do hóspede até o e-mail ao hotel" de="Robô de envio" para="Planilhas dos hotéis (Drive)">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5aa9ff;strokeWidth=2;dashed=1;flowAnimation=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontColor=#e8edf6;fontSize=11;labelBackgroundColor=#182133;" edge="1" parent="1" source="n_robo" target="n_planhot"><mxGeometry relative="1" as="geometry"/></mxCell>
        </object>
        <object label="registra o envio" id="e_11_robo__c_log" caminho="Pedido do hóspede até o e-mail ao hotel" de="Robô de envio" para="Log de Envios">
