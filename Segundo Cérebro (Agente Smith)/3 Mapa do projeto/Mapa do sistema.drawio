        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;MÓDULO  ·  a cada 5 min&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Números da Gerência&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Junta Central e Mail Analytics&lt;/font&gt;" id="n_painel_metricas" tipo="Módulo" quando="a cada 5 min" roda_em="Cada PC" o_que_faz="Números das telas Visão geral e Hotéis, juntando a Central (solicitações), o Mail Analytics e as NFs canceladas/substituídas renomeadas no Dropbox (canceladas.py — substituem a coluna do Mail Analytics)." codigo="src/painel_metricas.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3350" y="60" width="250" height="92" as="geometry"/></mxCell>
