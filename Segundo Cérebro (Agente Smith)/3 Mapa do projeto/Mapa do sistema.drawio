          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3350" y="810" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  contínuo&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Saúde do sistema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Faixa vermelha quando algo foge&lt;/font&gt;" id="n_saude" tipo="Processo" quando="contínuo" roda_em="Cada PC" o_que_faz="Saúde do sistema — uma faixa vermelha no topo do Painel quando algo sai do normal (usuário, 11/10/2026)." codigo="src/saude.py">
