          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2880" y="1785" width="250" height="92" as="geometry"/></mxCell>
