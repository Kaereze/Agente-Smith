        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  45 s · 12 PDFs&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Notas achadas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Acha a nota pelo CPF no PDF&lt;/font&gt;" id="n_nf_achadas" tipo="Processo" quando="45 s · 12 PDFs" roda_em="Cada PC" o_que_faz="NF achadas nas pastas do Dropbox pelo CPF/CNPJ de dentro do PDF (27/10/2026, desenho aprovado pelo João)." codigo="src/nf_achadas.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2880" y="1935" width="250" height="92" as="geometry"/></mxCell>
