        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  só com etiqueta&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Atualizador de versão&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Puxa a versão nova do GitHub&lt;/font&gt;" id="n_atualizador" tipo="Processo" quando="só com etiqueta" roda_em="Cada PC" o_que_faz="Mantém o código de cada PC igual ao do GitHub (pedido do usuário, 06/10/2026: alterar num PC, dar push, e os outros ficarem em sincronia)." codigo="src/atualizador.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3350" y="1260" width="250" height="92" as="geometry"/></mxCell>
