        </object>
        <object label="Drive avisa em 1–2 s" id="e_3_planhot__vigia" caminho="Pedido do hóspede até o e-mail ao hotel" de="Planilhas dos hotéis (Drive)" para="Vigia de formulários">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5aa9ff;strokeWidth=2;dashed=1;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#e8edf6;fontSize=11;labelBackgroundColor=#182133;" edge="1" parent="1" source="n_planhot" target="n_vigia"><mxGeometry relative="1" as="geometry"/></mxCell>
        </object>
        <object label="lê a cada 10 min" id="e_4_planhot__sync" caminho="Pedido do hóspede até o e-mail ao hotel" de="Planilhas dos hotéis (Drive)" para="Cópia para a Central">
