      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="q_f1" value="1 · DE ONDE VÊM OS DADOS" style="rounded=1;arcSize=3;dashed=1;fillColor=#8fa1b8;fillOpacity=7;strokeColor=#8fa1b8;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#8fa1b8;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="26" y="2" width="318" height="1561.6" as="geometry"/></mxCell>
        <mxCell id="q_f2" value="2 · COLETA E OUTLOOK DE CADA PC" style="rounded=1;arcSize=3;dashed=1;fillColor=#6f9bff;fillOpacity=7;strokeColor=#6f9bff;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#6f9bff;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="526" y="2" width="818" height="1561.6" as="geometry"/></mxCell>
        <mxCell id="q_f3" value="3 · PLANILHA CENTRAL" style="rounded=1;arcSize=3;dashed=1;fillColor=#e6b25c;fillOpacity=7;strokeColor=#e6b25c;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#e6b25c;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="1526" y="153.20000000000002" width="318" height="1242.4" as="geometry"/></mxCell>
        <mxCell id="q_f4" value="4 · PAINEL FISCAL, UM EM CADA PC" style="rounded=1;arcSize=3;dashed=1;fillColor=#a98bf0;fillOpacity=7;strokeColor=#a98bf0;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#a98bf0;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="2026" y="52.400000000000006" width="818" height="1443.9999999999998" as="geometry"/></mxCell>
        <mxCell id="q_f5" value="5 · SAÍDA" style="rounded=1;arcSize=3;dashed=1;fillColor=#46d3e6;fillOpacity=7;strokeColor=#46d3e6;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#46d3e6;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="3026" y="942.8" width="318" height="553.5999999999999" as="geometry"/></mxCell>
        <mxCell id="q_f6" value="LEITURA DA GERÊNCIA" style="rounded=1;arcSize=3;dashed=1;fillColor=#8fa1b8;fillOpacity=7;strokeColor=#8fa1b8;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#8fa1b8;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="3026" y="2" width="318" height="352" as="geometry"/></mxCell>
        <mxCell id="q_f7" value="OS 4 COMPUTADORES DO FINANCEIRO" style="rounded=1;arcSize=3;dashed=1;fillColor=#ff7ab6;fillOpacity=7;strokeColor=#ff7ab6;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#ff7ab6;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="1026" y="1614.8" width="1818" height="184" as="geometry"/></mxCell>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;GATILHO  ·  início&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Hóspede pede a nota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Preenche o formulário do hotel&lt;/font&gt;" id="n_hospede" tipo="Gatilho" quando="início" roda_em="Fora do sistema" o_que_faz="Tudo começa quando o hóspede, ou o hotel por ele, preenche o formulário de nota fiscal. O pedido também pode vir por e-mail ou por ligação; a ligação o agente marca à mão no Painel (aba Ligacoes)." regras="Para emitir a nota é preciso nome, CPF ou CNPJ e o que entra na nota: diárias, consumo ou estacionamento.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  2 versões&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Formulário de NF (Google Forms)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Antigo (36 col.) e novo (18 col.)&lt;/font&gt;" id="n_form" tipo="Fonte" quando="2 versões" roda_em="Google" o_que_faz="Cada hotel tem o seu formulário. O antigo tem 36 colunas; o novo tem 18, com documento do tomador, check-in e check-out e valor da nota. A resposta cai numa planilha do hotel no Drive." regras="A cópia junta as duas versões na mesma aba da Central do hotel, com as colunas do formulário novo no fim." codigo="src/sincronizar.py (juntar_planilhas)">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="228" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;GATILHO  ·  a qualquer hora&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;E-mail do hóspede&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Respostas, cobranças, correções&lt;/font&gt;" id="n_emailh" tipo="Gatilho" quando="a qualquer hora" roda_em="Fora do sistema" o_que_faz="O hóspede responde o e-mail do pedido ou escreve para a caixa do hotel: pede correção, cobra a nota, manda documento. Chega por POP3 nas caixas dos hotéis, que ficam no Outlook de cada PC." regras="Mais de 7 dias sem resposta, ou pedido de correção, vira Urgência no Painel.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  varre a cada 5 min&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dropbox das notas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;PDFs das NFs já emitidas&lt;/font&gt;" id="n_dropbox" tipo="Fonte" quando="varre a cada 5 min" roda_em="Cada PC lê o seu Dropbox" o_que_faz="Quatro pastas, uma por agente, onde o PDF da nota emitida é salvo. O sistema só lê: confere o nome (NF 123 - NOME), lê o CPF ou CNPJ de dentro do PDF (com OCR quando é escaneado) e compara com o pedido." regras="Notas canceladas e substituídas são arquivos renomeados na pasta, lidos como só leitura. | Arquivos que estão só online no Dropbox são pulados." codigo="src/confirmar_nfs.py, nf_achadas.py, canceladas.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="816" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;GATILHO  ·  commit + etiqueta&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Quem programa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;João e o Claude&lt;/font&gt;" id="n_dev" tipo="Gatilho" quando="commit + etiqueta" roda_em="Cópia de trabalho, nunca a pasta do Painel do João" o_que_faz="Mudança de código vai para a main com uma etiqueta de versão (AAAA.MM.DD.N), e as 3 branches dos PCs ficam iguais à main. Só documentação sobe sem etiqueta." regras="Nunca force push, nunca mover ou apagar etiqueta publicada. | Desenho primeiro, código só depois do OK do João." codigo="Cofre: Como entregar">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="1219.2" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  main + 3 branches&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;GitHub (privado)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Kaereze/Notas-Fiscais&lt;/font&gt;" id="n_github" tipo="Armazena" quando="main + 3 branches" roda_em="GitHub" o_que_faz="Guarda o código e o cofre Segundo Cérebro. As branches Bernardo, Christian e clara espelham a main; os PCs só atualizam quando há versão etiquetada." regras="Nunca guardar senhas, chaves ou dados reais de hóspedes.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="1437.6" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  só leitura&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Planilhas dos hotéis (Drive)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Uma por hotel, só leitura&lt;/font&gt;" id="n_planhot" tipo="Armazena" quando="só leitura" roda_em="Google Drive" o_que_faz="Onde o Google grava as respostas. O sistema só lê, com uma exceção autorizada em 15/10/2026: depois que o e-mail do pedido aparece em Itens Enviados, o robô marca TRUE na coluna Enviado." regras="As respostas nunca são alteradas pelo sistema." codigo="src/sincronizar.py, sheets.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="560" y="228" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  4 PCs&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Outlook de cada PC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Caixas dos hotéis (POP3)&lt;/font&gt;" id="n_outlook" tipo="Armazena" quando="4 PCs" roda_em="Cada PC tem só as caixas dos hotéis dele" o_que_faz="É onde chegam os pedidos do robô e as respostas dos hóspedes, e de onde saem as notas. O Painel é espelho do Outlook: quem guarda o histórico é o Outlook, não o Painel." regras="O Outlook precisa estar aberto com janela. Aberto só pelo COM (escondido) não recebe e-mail; o guardião confere a cada 60 s. | Janela 'E-mail da Internet' pedindo senha costuma ser o servidor recusando a conexão." codigo="src/outlook.py, outlook_vivo.py, identidade.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  só com etiqueta&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Atualizador de versão&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Cada PC puxa a versão nova&lt;/font&gt;" id="n_atual" tipo="Processo" quando="só com etiqueta" roda_em="Cada PC, dentro do Painel" o_que_faz="O Painel pergunta ao GitHub de tempos em tempos e quando alguém aperta Atualizar todos. Se dá para avançar sem conflito, baixa o código e reinicia pela tarefa SolicitacoesNF_Reiniciar do Windows." regras="Usa git fetch --tags e merge --ff-only. | Pasta com arquivo alterado à mão trava a atualização daquele PC. | Registro em logs/atualizacao.log." codigo="src/atualizador.py, Automacoes/reiniciar_servicos.ps1">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="560" y="1437.6" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  10–20 s · PC principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Vigia de formulários&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Pergunta ao Drive o que mudou&lt;/font&gt;" id="n_vigia" tipo="Processo" quando="10–20 s · PC principal" roda_em="PC principal" o_que_faz="A cada poucos segundos pergunta ao Drive quais planilhas mudaram (a listagem não gasta a cota das planilhas). Copia só aqueles hotéis para a Central e avisa os Painéis pela rede, para o pedido aparecer em 10–20 s em vez de 6–12 min." regras="Espera enquanto a rodada de 10 em 10 minutos está copiando. | Usa uma fatia própria da cota do Google." codigo="src/vigia_formularios.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="60" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  a cada 10 min · PC principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cópia para a Central&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Copia respostas dos hotéis&lt;/font&gt;" id="n_sync" tipo="Processo" quando="a cada 10 min · PC principal" roda_em="PC principal, pelo Agendador do Windows" o_que_faz="Rodada completa: copia as planilhas que mudaram para as abas da Central e, logo em seguida, roda o robô de envio." regras="Se a cópia parar, a Saúde acende a faixa vermelha (já ficou 2,5 dias parada em outubro). | A Conferência da Cópia compara cada hotel com a Central." codigo="src/sincronizar.py, Automacoes/agendar_sincronizacao.ps1">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="228" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  a cada 10 min · PC principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Robô de envio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Um e-mail por pedido, ao hotel&lt;/font&gt;" id="n_robo" tipo="Processo" quando="a cada 10 min · PC principal" roda_em="PC principal" o_que_faz="Lê os pedidos sem TRUE na Central, monta o e-mail em HTML com um código NF-… e manda para a caixa notafiscal@ do próprio hotel. Só marca TRUE na planilha do hotel depois de ver o e-mail em Itens Enviados." regras="Um diário de envios (anotado antes de enviar) impede reenvio se o processo morrer entre enviar e marcar. | Antes de enviar confere se o código NF-… já está em Itens Enviados ou na Caixa de Saída: não duplica. | O servidor de e-mail limita 250 envios por hora." codigo="src/main.py, montar_email.py, outlook.py, diario_envios.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="396" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  automático&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Envio pelo PC dono da caixa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;A caixa do hotel envia por si&lt;/font&gt;" id="n_donoenv" tipo="Processo" quando="automático" roda_em="PC principal pede; o PC dono envia" o_que_faz="Cada caixa de hotel está no Outlook de um PC só. Se não está no PC do robô, ele pede ao PC dono: primeiro pela rede do escritório (na hora); se a rede não chega, pela fila Envios_NF. O PC dono manda da própria caixa do hotel e confere em Itens Enviados." regras="Nunca sai pela conta do Ondina. | PC dono desligado: o e-mail espera sem TRUE; passou de 2 h, o alarme de pedido parado avisa no Painel." codigo="src/envio_pc_dono.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="564" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  a cada 20 s · cada PC&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Vigia do Outlook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Só olha, não grava&lt;/font&gt;" id="n_vigout" tipo="Processo" quando="a cada 20 s · cada PC" roda_em="Cada PC" o_que_faz="Olha se chegou ou saiu e-mail novo. Se sim, avisa o conferente, que roda na hora a conferência completa. Sem novidade, a conferência segue no ritmo normal, a cada 2 minutos." codigo="src/vigia_outlook.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="732" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  1–2 min · cada PC&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Conferente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Liga e-mail, pedido e nota&lt;/font&gt;" id="n_conf" tipo="Processo" quando="1–2 min · cada PC" roda_em="Cada PC; no principal também atende os comandos do menu da planilha" o_que_faz="Acompanha Itens Enviados e o Dropbox, confirma que a nota enviada bate com a solicitação (nome, CPF ou CNPJ, valor) e põe selo e etiquetas nos e-mails de solicitação." regras="Só nota confirmada vira evento; as ilegíveis ficam de fora. | Reconhece o assunto 'NF 123 - NOME' com anexo, ou um PDF no Dropbox." codigo="src/conferente.py, confirmar_nfs.py, controle_nf.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="900" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  só quando muda&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Espelho de e-mails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Caixa de entrada para a Central&lt;/font&gt;" id="n_espelho" tipo="Processo" quando="só quando muda" roda_em="Cada PC" o_que_faz="Reflete em abas de passagem da Central a Caixa de Entrada inteira (menos respondidos e solicitações do robô) e os Itens Enviados das últimas 72 horas. Reescreve a cada volta, só se mudou: nada se acumula." regras="Lido no Outlook só vale depois de 5 minutos; não lido vale na hora. | Respondido é quando saiu e-mail da caixa para quem escreveu; excluído some da lista." codigo="src/espelho_emails.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="1068" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  12 meses&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Índice local de e-mails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Banco SQLite neste PC&lt;/font&gt;" id="n_indice" tipo="Armazena" quando="12 meses" roda_em="Cada PC, fora do git e do Google" o_que_faz="Banco local (estado/indice_emails.sqlite) com 12 meses de Entrada, Enviados e Excluídos das caixas do PC. Responde a pesquisa em milissegundos." regras="Montado aos poucos, cerca de 1 s de Outlook por vez, para não atrapalhar o robô. | O que passa de 12 meses sai na faxina diária. | Dado de hóspede fica só no PC e no Outlook." codigo="src/indice_emails.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="1236" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Abas por hotel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Respostas copiadas&lt;/font&gt;" id="n_c_hot" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Uma aba por hotel com as respostas do formulário antigo e do novo juntas. Gravada pela cópia do PC principal; lida pelo robô e pelo Painel." codigo="src/sheets.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="211.20000000000002" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cadastro_Hoteis e Status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Hotel, e-mail, agente&lt;/font&gt;" id="n_c_cad" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="O cadastro diz qual e-mail e qual agente cuidam de cada hotel (sem linha de cabeçalho). Status guarda o liga e desliga do robô." codigo="src/sheets.py, hoteis.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="362.40000000000003" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Envios_NF e Anexos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Fila de envio entre PCs&lt;/font&gt;" id="n_c_env" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Fila que só cresce no fim, com os estados PEDIDO, ASSUMIDO, ENVIADO e FALHOU. Anexos do computador viajam em partes e são apagados depois do envio; anexos do Dropbox viajam como caminho relativo." regras="Faxina de 3 dias." codigo="src/envio_nf.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="513.6" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Log de Envios&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Histórico dos envios&lt;/font&gt;" id="n_c_log" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Registro de cada envio do robô, para conferir depois o que saiu, quando e para quem." codigo="src/historico.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="664.8000000000001" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Tratamento&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Uma linha por fato (A:H)&lt;/font&gt;" id="n_c_trat" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Registro que só cresce no fim: tudo o que acontece com cada solicitação (nota confirmada, para quem foi, tratativa, nota única ou dividida, quem está com ela)." regras="A faxina resume o que tem mais de 3 dias e tira solicitações com mais de 150 dias, depois de conferir que o estado de cada uma fica idêntico.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="816" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Correio_&amp;lt;PC&amp;gt;, CorreioTexto, CaixaPedidos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Espelho das caixas&lt;/font&gt;" id="n_c_cor" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Abas de passagem, uma de cada tipo por PC: a Caixa de Entrada espelhada, o texto dos e-mails e as solicitações do robô que estão na Caixa de Entrada.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="967.2" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Eventos, Ligações e Atividade&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Lido, excluído, urgência&lt;/font&gt;" id="n_c_evt" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Eventos_Correio guarda lido, excluído e urgência; Ligacoes guarda a marca do agente; Atividade_Robo é o registro de todos os PCs." regras="Eventos: 3 dias. Atividade: 7 dias. Ligações: 400 dias.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="1118.3999999999999" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  Central&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PCs_Painel e Comandos_PC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Quem está ligado e recados&lt;/font&gt;" id="n_c_pcs" tipo="Armazena" quando="Central" roda_em="Planilha Central" o_que_faz="Cada Painel publica a cada minuto quem é, quais caixas tem, se o Outlook está aberto, a versão do código e a saúde. Comandos_PC é o quadro de recados: um PC pede (por exemplo, atualizar), o de destino executa e responde." codigo="src/rede_pcs.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="1269.6000000000001" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  1 vez por dia · principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Faxina diária&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Nada vira bola de neve&lt;/font&gt;" id="n_faxina" tipo="Processo" quando="1 vez por dia · principal" roda_em="PC principal" o_que_faz="Resume e remove o que passou do prazo nas abas de registro, com cópia de segurança antes de mexer no Tratamento. Também a limpeza local do que cresce sozinho (cache da janela do Painel)." regras="Fila, anexos, comandos, lido e excluído: 3 dias. Atividade do robô: 7 dias. | Antes de gravar, confere que o estado de cada solicitação fica idêntico." codigo="src/faxina.py, limpeza.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2060" y="110.4" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  contínuo&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Saúde do sistema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Faixa vermelha quando foge&lt;/font&gt;" id="n_saude" tipo="Processo" quando="contínuo" roda_em="Cada PC publica; a tela mostra" o_que_faz="Avisa quando a cópia está parada, o Outlook está sem janela, há e-mails presos na Caixa de Saída, uma caixa pede senha ou um pedido está parado. Também dispara um aviso do Windows." codigo="src/saude.py, avisos_windows.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2060" y="312" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  relê a cada 15 s&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Servidor do Painel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;127.0.0.1:8765 em cada PC&lt;/font&gt;" id="n_srv" tipo="Processo" quando="relê a cada 15 s" roda_em="Cada PC, ligado com o Windows" o_que_faz="Cérebro local do Painel. Um laço lê a Central, as notas achadas, a Gerência e as canceladas, guarda um cache e entrega tudo à tela por uma API JSON. Só aceita conexão do próprio PC e exige um token nas ações." regras="Janela fechada relê a cada 60 s, para poupar a cota do Google. | Fechar a janela só esconde; o servidor continua. | Em casa, o modo demonstração usa dados fictícios." codigo="src/app_servidor.py (Estado, criar_handler)">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2060" y="631.1999999999999" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  45 s · 12 PDFs&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Notas achadas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Acha a nota pelo CPF no PDF&lt;/font&gt;" id="n_nfach" tipo="Processo" quando="45 s · 12 PDFs" roda_em="Linha de fundo do Painel" o_que_faz="Varre PDFs recentes do Dropbox, extrai o CPF ou CNPJ e monta o índice estado/nf_achadas.json. Mostra na ficha que já existe nota daquele documento e confere se a nota já enviada cobre o que o hóspede pede agora." regras="Janela de 30 dias; nota fresca 72 h; nota pronta 168 h." codigo="src/nf_achadas.py, nf_cobre.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2060" y="1034.4" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  sem gastar cota&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Rede local do escritório&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Porta 8766, pedidos assinados&lt;/font&gt;" id="n_rede" tipo="Processo" quando="sem gastar cota" roda_em="Cada PC" o_que_faz="Conversa direta entre os Painéis dos 4 PCs: busca ao vivo no Outlook, texto de um e-mail, aviso de que há novidade, envio pelo PC dono e Enviar/Receber. Não passa pelo Google." regras="Só aceita IP da rede local (10.x, 172.16–31.x, 192.168.x). | Todo pedido vem assinado (HMAC) com um segredo tirado da chave do Google, e vale 2 minutos. | Só e-mail de caixa de hotel sai, nunca de caixa pessoal. | Melhoria combinada, aguardando OK: pedido de uso único e validade de 30 s." codigo="src/rede_local.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2060" y="1236" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  a cada 5 min&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Números da Gerência&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Junta Central e Mail Analytics&lt;/font&gt;" id="n_metricas" tipo="Processo" quando="a cada 5 min" roda_em="Cada PC" o_que_faz="Junta as solicitações da Central com os números que o Mail Analytics já grava (recebidos, enviados, ligações, substituições e cancelamentos, notas) e compara o mês com o anterior." codigo="src/painel_metricas.py, relatorio_semana.py, fiscal_intelligence.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="144" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;TELA  ·  claro e escuro&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Telas do Painel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Janela do aplicativo&lt;/font&gt;" id="n_ui" tipo="Tela" quando="claro e escuro" roda_em="Cada PC" o_que_faz="Visão geral, Hotéis, Notas fiscais, Caixa de entrada, Itens enviados, Gerência, Atividade e Robô. É uma janela de aplicativo; o X só esconde." codigo="app_ui/index.html, painel.js, correio.js, robo.js, pecas/*; src/app_janela.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="446.4" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;TELA  ·  histórico de 24 h&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Busca&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Nome, e-mail, CPF ou frase&lt;/font&gt;" id="n_busca" tipo="Tela" quando="histórico de 24 h" roda_em="Cada PC" o_que_faz="Pesquisa pelo índice local dos 4 PCs, em milissegundos; a opção ao vivo pergunta direto ao Outlook de cada PC pela rede. Guarda as pesquisas das últimas 24 horas só no navegador daquele PC, sem CPF ou CNPJ." codigo="src/busca_outlook.py, indice_emails.py; app_ui/pecas/busca_recente.js">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="631.1999999999999" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;AÇÃO  ·  com token&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Ações do agente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;O que a equipe faz na tela&lt;/font&gt;" id="n_acoes" tipo="Ação" quando="com token" roda_em="Cada PC" o_que_faz="Marcar lido ou não lido, urgência (botão direito), excluir (com Desfazer por 10 s), responder, encaminhar, tratativa, nota dividida, marcar Ligação, concluir a conversa e mover o e-mail para a pasta NF enviada." regras="O Painel nunca tira nem apaga e-mail da entrada sozinho. | Abrir um e-mail no Painel marca como lido no Outlook." codigo="src/app_servidor.py (rotas /api/...)">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="816" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;AÇÃO  ·  da caixa do hotel&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Enviar NF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Com conferência antes&lt;/font&gt;" id="n_envnf" tipo="Ação" quando="da caixa do hotel" roda_em="PC que pede; o PC dono envia" o_que_faz="O agente escolhe o PDF (o Painel sugere os do Dropbox), o sistema confere se a nota bate com a solicitação e envia da caixa do próprio hotel. Se a caixa está neste PC, envia na hora; se está em outro, avisa pela rede e deixa o pedido na fila como reserva." codigo="src/envio_nf.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="1000.8" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;AÇÃO  ·  pela rede&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Enviar/Receber todas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Roda o F9 nos 4 Outlooks&lt;/font&gt;" id="n_envrec" tipo="Ação" quando="pela rede" roda_em="Cada PC responde por si" o_que_faz="O Painel pede aos 4 PCs, pela rede deles, que rodem o Enviar/Receber do próprio Outlook. Também manda o que estiver preso na Caixa de Saída. Guarda quanto cada PC demorou e usa a mediana como estimativa." codigo="src/enviar_receber.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="1185.6000000000001" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;AÇÃO  ·  botão&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Atualizar todos os PCs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Recado pela Central&lt;/font&gt;" id="n_cmd" tipo="Ação" quando="botão" roda_em="Qualquer PC" o_que_faz="Grava o comando atualizar em Comandos_PC. Cada PC baixa a versão etiquetada mais nova e reinicia o Painel. O resultado de cada um aparece na página Atividade." codigo="src/rede_pcs.py, atualizador.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="1370.3999999999999" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  produção&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Mail Analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Planilha de números, só leitura&lt;/font&gt;" id="n_mailan" tipo="Fonte" quando="produção" roda_em="Google Sheets" o_que_faz="Planilha em produção que conta recebidos, enviados, ligações, substituições e cancelamentos e notas por agente e dia. Este sistema só lê e nunca altera." regras="No fim de semana, vira uma linha de domingo gravada na segunda de manhã.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3060" y="60" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  só leitura&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Fiscal Intelligence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Gravada pelo Mail Analytics&lt;/font&gt;" id="n_fi" tipo="Fonte" quando="só leitura" roda_em="Google Sheets" o_que_faz="Planilha de apoio gravada pelo Mail Analytics. O Painel lê a cada 5 minutos para a Gerência." codigo="src/fiscal_intelligence.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3060" y="228" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;SAÍDA  ·  COM do Outlook&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Outlook do PC dono envia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Sai da caixa do próprio hotel&lt;/font&gt;" id="n_donoout" tipo="Saída" quando="COM do Outlook" roda_em="O PC que tem a caixa do hotel" o_que_faz="O envio acontece sempre pelo Outlook do PC que tem aquela caixa de hotel. O e-mail do robô vai da caixa do hotel para ela mesma; a nota vai da caixa do hotel para o hóspede." codigo="src/outlook.py, envio_pc_dono.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3060" y="1000.8" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  confirma&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Itens Enviados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;A prova de que saiu&lt;/font&gt;" id="n_itens" tipo="Processo" quando="confirma" roda_em="Outlook do PC dono" o_que_faz="O envio só conta como feito depois que o e-mail aparece em Itens Enviados. Só então o robô marca TRUE e o conferente reconhece a nota." regras="Resposta do hóspede com a nota anexada não conta como envio.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3060" y="1185.6000000000001" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;SAÍDA  ·  fim&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Hóspede recebe a nota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Por e-mail&lt;/font&gt;" id="n_hospdest" tipo="Saída" quando="fim" roda_em="Fora do sistema" o_que_faz="A nota fiscal chega na caixa do hóspede, enviada pela caixa do hotel. Se ele responder, a conversa volta para a Caixa de Entrada do PC dono.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="3060" y="1370.3999999999999" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR  ·  tudo&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;João&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;PC principal&lt;/font&gt;" id="n_pc_joao" tipo="Computador" quando="tudo" roda_em="Trabalho; sessão de código do Claude" o_que_faz="Além do que todos os PCs rodam, este faz a cópia dos hotéis (a cada 10 min), a vigia de formulários, o robô de envio, a conferência diária e a faxina. Fim de semana trabalham João e Cristian." regras="Todos os PCs rodam: Painel (tarefa no logon), conferente (a cada 10 min, que se mantém ligado), guardião do Outlook e vigia do Outlook. | O Painel do João é onde o código novo aparece primeiro; por isso o trabalho de código é feito numa cópia.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="1672.8" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR  ·  caixas dela&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Clara&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Painel, conferente e Outlook&lt;/font&gt;" id="n_pc_clara" tipo="Computador" quando="caixas dela" roda_em="Trabalho" o_que_faz="Roda o Painel e o conferente e tem no Outlook as caixas dos hotéis dela. Sem permissão de administrador: liberar a porta 8766 no firewall exige alguém com administrador.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1560" y="1672.8" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR  ·  caixas dele&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cristian&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Painel, conferente e Outlook&lt;/font&gt;" id="n_pc_cris" tipo="Computador" quando="caixas dele" roda_em="Trabalho" o_que_faz="Roda o Painel e o conferente. Trabalha no fim de semana junto com o João, e esse fim de semana conta para ele na Gerência.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2060" y="1672.8" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;COMPUTADOR  ·  caixas dele&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Bernardo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Painel, conferente e Outlook&lt;/font&gt;" id="n_pc_bern" tipo="Computador" quando="caixas dele" roda_em="Trabalho" o_que_faz="Roda o Painel e o conferente e tem no Outlook as caixas dos hotéis dele.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2560" y="1672.8" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <mxCell id="nota_1" value="&lt;b&gt;Cota do Google&lt;/b&gt;&lt;br&gt;60 leituras por minuto somando os 4 PCs. Toda leitura nova entra na conta; por isso cada programa tem a sua fatia (cota_google.py)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1670" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="nota_2" value="&lt;b&gt;Nada acumula&lt;/b&gt;&lt;br&gt;O Painel não é histórico: quem guarda é o Outlook e a planilha de cada hotel. As abas de registro têm faxina de 3 a 7 dias." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1670" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="nota_3" value="&lt;b&gt;Dado de hóspede&lt;/b&gt;&lt;br&gt;Só no Outlook e no índice local de cada PC. Nunca em arquivo de teste, documento ou GitHub." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#3a3220;strokeColor=#6e5c2b;fontColor=#f2dfaa;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3060" y="1670" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;CAMINHOS (cor da linha)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5aa9ff&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Pedido do hóspede até o e-mail ao hotel&lt;br&gt;&lt;font color=&quot;#ffb454&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; E-mails, Outlook e telas&lt;br&gt;&lt;font color=&quot;#b69cff&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Nota fiscal e envio ao hóspede&lt;br&gt;&lt;font color=&quot;#ff7ab6&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Os 4 PCs entre si&lt;br&gt;&lt;font color=&quot;#8fa1b8&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Código e atualização&lt;br&gt;&lt;font color=&quot;#46d3e6&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Números da Gerência&lt;br&gt;&lt;font color=&quot;#ff6b6b&quot;&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Faxina e saúde&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#93a1b8&quot;&gt;Linha tracejada com setas: o sentido em que o dado anda.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#141b2a;strokeColor=#25324a;fontColor=#e8edf6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="-250" width="420" height="190" as="geometry"/></mxCell>
        <object label="preenche o formulário" id="e_1_hospede__form" caminho="Pedido do hóspede até o e-mail ao hotel" de="Hóspede pede a nota" para="Formulário de NF (Google Forms)">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5aa9ff;strokeWidth=2;dashed=1;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#e8edf6;fontSize=11;labelBackgroundColor=#182133;" edge="1" parent="1" source="n_hospede" target="n_form"><mxGeometry relative="1" as="geometry"/></mxCell>
        </object>
