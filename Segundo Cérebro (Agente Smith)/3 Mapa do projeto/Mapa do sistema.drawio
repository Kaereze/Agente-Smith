        </object>
        <object label="caixa em outro PC?" id="e_12_robo__donoenv" caminho="Pedido do hóspede até o e-mail ao hotel" de="Robô de envio" para="Envio pelo PC dono da caixa">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5aa9ff;strokeWidth=2;dashed=1;flowAnimation=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#e8edf6;fontSize=11;labelBackgroundColor=#182133;" edge="1" parent="1" source="n_robo" target="n_donoenv"><mxGeometry relative="1" as="geometry"/></mxCell>
        </object>
        <object label="envia pelo PC dono" id="e_13_donoenv__outlook" caminho="Pedido do hóspede até o e-mail ao hotel" de="Envio pelo PC dono da caixa" para="Outlook de cada PC">
