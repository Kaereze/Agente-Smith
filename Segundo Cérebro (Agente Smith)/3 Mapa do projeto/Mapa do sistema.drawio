        <mxCell id="q_f14" value="QUALIDADE, FERRAMENTAS E DOCUMENTOS" style="rounded=1;arcSize=3;dashed=1;fillColor=#a98bf0;fillOpacity=7;strokeColor=#a98bf0;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#a98bf0;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="26" y="3602" width="2668" height="334" as="geometry"/></mxCell>
        <mxCell id="q_f15" value="OS 4 COMPUTADORES DO FINANCEIRO" style="rounded=1;arcSize=3;dashed=1;fillColor=#ff7ab6;fillOpacity=7;strokeColor=#ff7ab6;strokeOpacity=45;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontColor=#ff7ab6;fontStyle=1;fontSize=15;html=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="966" y="4052" width="1728" height="184" as="geometry"/></mxCell>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;GATILHO  ·  início&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Hóspede pede a nota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Preenche o formulário do hotel&lt;/font&gt;" id="n_hospede" tipo="Gatilho" quando="início" roda_em="Fora do sistema" o_que_faz="Tudo começa quando o hóspede, ou o hotel por ele, preenche o formulário de nota fiscal. O pedido também pode vir por e-mail ou por ligação; a ligação o agente marca à mão no Painel." regras="Para emitir é preciso nome, CPF ou CNPJ e o que entra na nota: diárias, consumo ou estacionamento.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  2 versões&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Formulário de NF (Google Forms)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Antigo (36 col.) e novo (18 col.)&lt;/font&gt;" id="n_form" tipo="Fonte" quando="2 versões" roda_em="Google" o_que_faz="Cada hotel tem o seu formulário. O antigo tem 36 colunas; o novo tem 18, com documento do tomador, check-in e check-out e valor. A resposta cai numa planilha do hotel no Drive." regras="A cópia junta as duas versões na mesma aba da Central do hotel." codigo="src/sincronizar.py (juntar_planilhas)">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;GATILHO  ·  a qualquer hora&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;E-mail do hóspede&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Respostas, cobranças, correções&lt;/font&gt;" id="n_emailh" tipo="Gatilho" quando="a qualquer hora" roda_em="Fora do sistema" o_que_faz="O hóspede responde o e-mail do pedido ou escreve para a caixa do hotel: pede correção, cobra a nota, manda documento." regras="Mais de 7 dias sem resposta, ou pedido de correção, vira Urgência no Painel.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  convivência&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Robô antigo (Apps Script via Gmail)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Ainda atende alguns hotéis&lt;/font&gt;" id="n_robo_antigo_ext" tipo="Fonte" quando="convivência" roda_em="Google" o_que_faz="O robô antigo ainda manda e-mail de pedido para alguns hotéis. O sistema novo reconhece o que ele já atendeu para não mandar em dobro." codigo="src/robo_antigo.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="615" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  varre a cada 5 min&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dropbox das notas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;PDFs das NFs emitidas&lt;/font&gt;" id="n_dropbox" tipo="Fonte" quando="varre a cada 5 min" roda_em="Cada PC lê o seu Dropbox" o_que_faz="Quatro pastas, uma por agente, onde o PDF da nota emitida é salvo. O sistema só lê: confere o nome (NF 123 - NOME), lê o CPF ou CNPJ de dentro do PDF (OCR quando é escaneado) e compara com o pedido." regras="Canceladas e substituídas são arquivos renomeados na pasta, lidos como só leitura. | Arquivos só online no Dropbox são pulados." codigo="src/confirmar_nfs.py, nf_achadas.py, canceladas.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;GATILHO  ·  commit + etiqueta&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Quem programa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;João e o Claude&lt;/font&gt;" id="n_dev" tipo="Gatilho" quando="commit + etiqueta" roda_em="Cópia de trabalho, nunca a pasta do Painel do João" o_que_faz="Mudança de código vai para a main com uma etiqueta de versão (AAAA.MM.DD.N) e as 3 branches dos PCs ficam iguais à main. Só documentação sobe sem etiqueta." regras="Nunca force push nem mexer em etiqueta publicada. | Desenho primeiro, código só depois do OK do João." codigo="Cofre: Como entregar">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  main + 3 branches&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;GitHub (privado)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Kaereze/Notas-Fiscais&lt;/font&gt;" id="n_github" tipo="Armazena" quando="main + 3 branches" roda_em="GitHub" o_que_faz="Guarda o código e o cofre Segundo Cérebro. As branches Bernardo, Christian e clara espelham a main; os PCs só atualizam quando há versão etiquetada." regras="Nunca guardar senhas, chaves ou dados reais de hóspedes.">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  só leitura&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Planilhas dos hotéis (Drive)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Uma por hotel, só leitura&lt;/font&gt;" id="n_planhot" tipo="Armazena" quando="só leitura" roda_em="Google Drive" o_que_faz="Onde o Google grava as respostas. O sistema só lê, com uma exceção autorizada em 15/10/2026: depois que o e-mail do pedido aparece em Itens Enviados, o robô marca TRUE na coluna Enviado." regras="As respostas nunca são alteradas pelo sistema." codigo="src/sincronizar.py, sheets.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="210" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;FONTE  ·  250 envios por hora&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Servidor de e-mail (KingHost)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;POP3 recebe, SMTP envia&lt;/font&gt;" id="n_kinghost" tipo="Fonte" quando="250 envios por hora" roda_em="Internet" o_que_faz="É o servidor que entrega e recebe os e-mails das caixas dos hotéis. As contas são POP3: o Outlook só recebe e envia de verdade com a janela aberta." regras="Limite do servidor: 250 envios por hora. | Quando o servidor recusa a conexão, o Outlook pede senha mesmo com a senha certa." codigo="src/cota_envio.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="435" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;ARMAZENA  ·  4 PCs&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Outlook de cada PC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Caixas dos hotéis&lt;/font&gt;" id="n_outlook_app" tipo="Armazena" quando="4 PCs" roda_em="Cada PC tem só as caixas dos hotéis dele" o_que_faz="É onde chegam os pedidos do robô e as respostas dos hóspedes, e de onde saem as notas. O Painel é espelho do Outlook: quem guarda o histórico é o Outlook, não o Painel." regras="O Outlook precisa estar aberto com janela: aberto só pelo COM (escondido) não recebe e-mail. | O Painel nunca tira nem apaga e-mail da entrada sozinho." codigo="src/outlook.py, outlook_vivo.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="660" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  10–20 s · principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Vigia de formulários&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Pergunta ao Drive o que mudou&lt;/font&gt;" id="n_vigia_formularios" tipo="Processo" quando="10–20 s · principal" roda_em="PC principal" o_que_faz="Cópia rápida dos formulários (23/10/2026, OK do João): pedido do hóspede no Painel em ~10-20 s, e não 6-12 min." regras="Espera enquanto a rodada de 10 em 10 minutos está copiando. | Usa uma fatia própria da cota do Google." codigo="src/vigia_formularios.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  10 min · principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cópia para a Central&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Copia respostas dos hotéis&lt;/font&gt;" id="n_sincronizar" tipo="Processo" quando="10 min · principal" roda_em="PC principal, pelo Agendador do Windows" o_que_faz="Copia as respostas das planilhas dos hotéis (pasta do Drive) para as abas da Central." regras="Se a cópia parar, a Saúde acende a faixa vermelha (já ficou 2,5 dias parada em outubro)." codigo="src/sincronizar.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="210" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  sob pedido&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Conferência da cópia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Compara cada hotel com a Central&lt;/font&gt;" id="n_conferir_copia" tipo="Processo" quando="sob pedido" roda_em="PC principal" o_que_faz="Auditoria da cópia: compara a planilha de cada hotel com a aba correspondente na Central." codigo="src/conferir_copia.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="360" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  10 min · principal&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Robô de envio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Um e-mail por pedido, ao hotel&lt;/font&gt;" id="n_main" tipo="Processo" quando="10 min · principal" roda_em="PC principal" o_que_faz="Envio: lê pendentes, envia, confirma em Itens Enviados e só então marca TRUE." regras="Antes de enviar confere se o código NF-… já está em Itens Enviados ou na Caixa de Saída: não duplica. | Só marca TRUE depois de ver o e-mail em Itens Enviados." codigo="src/main.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1000" y="510" width="250" height="92" as="geometry"/></mxCell>
        </object>
        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;MÓDULO&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Montador do e-mail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;Assunto e HTML do pedido&lt;/font&gt;" id="n_montar_email" tipo="Módulo" roda_em="PC principal" o_que_faz="Assunto e HTML dos e-mails de solicitação. HTML com estilo inline: é o que o Outlook respeita." codigo="src/montar_email.py">
