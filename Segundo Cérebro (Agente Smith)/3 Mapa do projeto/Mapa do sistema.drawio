        <object label="&lt;font style=&quot;font-size:10px;color:#93a1b8&quot;&gt;PROCESSO  ·  relê a cada 15 s&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Servidor do Painel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#93a1b8&quot;&gt;127.0.0.1:8765 em cada PC&lt;/font&gt;" id="n_app_servidor" tipo="Processo" quando="relê a cada 15 s" roda_em="Cada PC, ligado com o Windows" o_que_faz="Painel Notas Fiscais: servidor HTTP só em 127.0.0.1 + janela do Edge em modo aplicativo." regras="Só aceita conexão do próprio PC e exige token nas ações. | Janela fechada relê a cada 60 s, para poupar a cota do Google. | Fechar a janela só esconde; o servidor continua." codigo="src/app_servidor.py">
          <mxCell style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#182133;strokeColor=#2c3a52;strokeWidth=1.5;fontColor=#e8edf6;shadow=1;" vertex="1" parent="1"><mxGeometry x="2880" y="840" width="250" height="92" as="geometry"/></mxCell>
