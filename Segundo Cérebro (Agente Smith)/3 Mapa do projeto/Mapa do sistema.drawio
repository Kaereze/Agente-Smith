        </object>
        <object label="pedidos sem TRUE" id="e_7_c_hot__robo" caminho="Pedido do hóspede até o e-mail ao hotel" de="Abas por hotel" para="Robô de envio">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5aa9ff;strokeWidth=2;dashed=1;flowAnimation=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontColor=#e8edf6;fontSize=11;labelBackgroundColor=#182133;" edge="1" parent="1" source="n_c_hot" target="n_robo"><mxGeometry relative="1" as="geometry"/></mxCell>
        </object>
        <object label="hotel, e-mail e agente" id="e_8_c_cad__robo" caminho="Pedido do hóspede até o e-mail ao hotel" de="Cadastro_Hoteis e Status" para="Robô de envio">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;jettySize=auto;orthogonalLoop=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5aa9ff;strokeWidth=2;dashed=1;flowAnimation=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontColor=#e8edf6;fontSize=11;labelBackgroundColor=#182133;" edge="1" parent="1" source="n_c_cad" target="n_robo"><mxGeometry relative="1" as="geometry"/></mxCell>
        </object>
        <object label="e-mail do pedido para a caixa do hotel" id="e_9_robo__outlook" caminho="Pedido do hóspede até o e-mail ao hotel" de="Robô de envio" para="Outlook de cada PC">
